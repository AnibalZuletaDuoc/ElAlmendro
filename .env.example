# ---------------------------------------------------------------------------
# TimeFlow - variables de entorno. Copiar como .env  ->  cp .env.example .env
# ---------------------------------------------------------------------------

# Capa de datos - PostgreSQL 16
POSTGRES_USER=timeflow
POSTGRES_PASSWORD=timeflow_dev
POSTGRES_DB=timeflow
POSTGRES_PORT=5432
DATABASE_URL="postgresql://timeflow:timeflow_dev@localhost:5432/timeflow?schema=public"

# Capa de archivos - MinIO (compatible S3)
MINIO_ROOT_USER=timeflow
MINIO_ROOT_PASSWORD=timeflow_dev
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=timeflow-evidencias
S3_ACCESS_KEY=timeflow
S3_SECRET_KEY=timeflow_dev
S3_REGION=us-east-1

# Capa de negocio - API NestJS
API_PORT=4000
JWT_ACCESS_SECRET=cambiar_en_produccion_access
JWT_REFRESH_SECRET=cambiar_en_produccion_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
APP_TIMEZONE=America/Santiago
SESION_UMBRAL_AUTOCIERRE_HORAS=10

# Capa de interfaz - Web Next.js
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Herramientas
ADMINER_PORT=8080
